<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for the notarized Developer ID build.

  signingStyle=automatic, and it must stay automatic.

  On a Mac, release.sh passes -allowProvisioningUpdates so Xcode can mint and
  refresh the Developer ID profiles for both bundle ids. On CI it passes neither
  that flag nor the API key: an App Store Connect key cannot create a Developer
  ID profile at all, and the attempt is a hard failure. Automatic signing with
  creation forbidden resolves from the profiles in packaging/profiles/, which is
  measured to work.

  Switching to manual is NOT the fallback, though an earlier version of this
  comment said so. Both profiles are Xcode-managed, and manual signing rejects
  those outright:

      error: ... is Xcode managed, but signing settings require a manually
             managed profile.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>developer-id</string>

    <key>teamID</key>
    <string>4A27X5PJP3</string>

    <key>signingStyle</key>
    <string>automatic</string>

    <key>signingCertificate</key>
    <string>Developer ID Application</string>

    <!-- We notarize explicitly in release.sh so the script can staple, verify and
         fail loudly. Letting Xcode do it here hides the submission log. -->
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
