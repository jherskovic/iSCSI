<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for iscsid. Install to /Library/LaunchDaemons/ and load with:
    sudo cp me.herko.iSCSIInitiator.daemon.plist /Library/LaunchDaemons/
    sudo launchctl load /Library/LaunchDaemons/me.herko.iSCSIInitiator.daemon.plist

  A LaunchDaemon (not a LaunchAgent) so the iSCSI session exists before login,
  letting a LUN auto-mount early in boot (but never as the boot volume — see
  docs/architecture.md).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.herko.iSCSIInitiator.daemon</string>
    <key>Program</key>
    <string>/usr/local/libexec/iscsid</string>
    <key>MachServices</key>
    <dict>
        <key>me.herko.iSCSIInitiator.daemon</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Adaptive</string>
    <key>StandardErrorPath</key>
    <string>/var/log/iscsid.log</string>
</dict>
</plist>
