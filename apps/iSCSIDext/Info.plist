<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>me.herko.iSCSIInitiator.dext</string>
    <key>CFBundleName</key>
    <string>iSCSIDext</string>
    <key>CFBundleExecutable</key>
    <string>me.herko.iSCSIInitiator.dext</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>DEXT</string>
    <!-- BUMP CFBundleVersion FOR EVERY DEXT CHANGE YOU WANT LOADED.
         sysextd keys replacement off the version: rebuilding with the same
         version leaves the OLD dext active ("already activated"), even though
         the app bundle contains the new binary — which looks exactly like the
         new code silently not working. Bumping it makes the swap a real
         upgrade, so no kill -9 workaround is needed.
         Bump it BY HAND: `plutil -replace` rewrites the whole file, reorders
         the keys and deletes these comments. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.2</string>
    <key>CFBundleVersion</key>
    <string>19</string>
    <key>OSBundleUsageDescription</key>
    <string>Presents iSCSI LUNs as local disks.</string>
    <key>IOKitPersonalities</key>
    <dict>
        <!--
          Two-personality chain for a hardware-less SCSI controller
          (IOUserSCSIParallelInterfaceController cannot parent on IOUserResources
          directly). See DevForums 836344 and WWDC20 #10210.
        -->

        <!-- (1) Bootstrap: always matches IOUserResources, carries the marker
             property, RegisterService()s so (2) can match it as a provider. -->
        <key>iSCSIBootstrap</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>CFBundleIdentifierKernel</key>
            <string>com.apple.kpi.iokit</string>
            <key>IOClass</key>
            <string>IOUserService</string>
            <key>IOUserClass</key>
            <string>iSCSIBootstrap</string>
            <key>IOProviderClass</key>
            <string>IOUserResources</string>
            <key>IOResourceMatch</key>
            <string>IOKit</string>
            <key>IOUserServerName</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>IOMatchCategory</key>
            <string>me.herko.iSCSIInitiator.dext.bootstrap</string>
            <!-- Marker the controller personality matches on. -->
            <key>iSCSIVirtualHBA</key>
            <true/>
        </dict>

        <!-- (2) The actual virtual SCSI HBA: matches the bootstrap nub by
             property. IOClass MUST be the SCSI family's kernel proxy. -->
        <key>iSCSIController</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <!-- IOUserSCSIParallelInterfaceController is vended by the SCSI
                 Parallel family kext, NOT the generic IOKit KPI. Naming the
                 wrong kernel bundle here makes IOKit fail to resolve IOClass
                 and silently DROP this personality (it never matches, no log).
                 Apple's own DriverKit SCSI controllers (AppleLSIFusionMPT) use
                 exactly this bundle id. -->
            <key>CFBundleIdentifierKernel</key>
            <string>com.apple.iokit.IOSCSIParallelFamily</string>
            <key>IOClass</key>
            <string>IOUserSCSIParallelInterfaceController</string>
            <key>IOUserClass</key>
            <string>iSCSIDext</string>
            <!-- Provider is our bootstrap nub (a plain IOUserService), matched
                 by the marker property it published via RegisterService(). -->
            <key>IOProviderClass</key>
            <string>IOUserService</string>
            <key>IOPropertyMatch</key>
            <dict>
                <key>iSCSIVirtualHBA</key>
                <true/>
            </dict>
            <!-- SCSI-family descriptive keys mirrored from Apple's working
                 IOUserSCSIParallelInterfaceController personality. -->
            <key>Physical Interconnect</key>
            <string>SCSI Parallel Interface</string>
            <key>Physical Interconnect Location</key>
            <string>Internal</string>
            <key>IOUnitName</key>
            <string>disk</string>
            <key>IOUserServerName</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>IOMatchCategory</key>
            <string>me.herko.iSCSIInitiator.dext.controller</string>
            <key>UserClientProperties</key>
            <dict>
                <key>IOClass</key>
                <string>IOUserUserClient</string>
                <key>IOUserClass</key>
                <string>iSCSIUserClient</string>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
