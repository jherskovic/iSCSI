<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>me.herko.iSCSIInitiator.dext</string>
    <key>CFBundleName</key>
    <string>iSCSIDext</string>
    <key>CFBundlePackageType</key>
    <string>DEXT</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>OSBundleUsageDescription</key>
    <string>Presents iSCSI LUNs as local disks.</string>
    <key>IOKitPersonalities</key>
    <dict>
        <!--
          Two-personality matching for a hardware-less controller:
          (1) a bootstrap personality matches IOUserResources and, in Start(),
              calls RegisterService() to publish the controller nub;
          (2) the SCSI controller personality is instantiated by the system.
          For the skeleton we use a single IOUserResources match; split into
          two if the upgrade/teardown flow needs an explicit nub (see
          docs/architecture.md).
        -->
        <key>iSCSIDext</key>
        <dict>
            <key>CFBundleIdentifier</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>CFBundleIdentifierKernel</key>
            <string>com.apple.kpi.iokit</string>
            <key>IOClass</key>
            <string>IOUserService</string>
            <key>IOUserClass</key>
            <string>iSCSIDext</string>
            <key>IOMatchCategory</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>IOProviderClass</key>
            <string>IOUserResources</string>
            <key>IOResourceMatch</key>
            <string>IOKit</string>
            <key>IOUserServerName</key>
            <string>me.herko.iSCSIInitiator.dext</string>
            <key>UserClientProperties</key>
            <dict>
                <key>IOClass</key>
                <string>IOUserUserClient</string>
                <key>IOUserClass</key>
                <string>iSCSIUserClient</string>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
