//
//  iSCSIDext.iig
//  DriverKit interface definition for the virtual iSCSI SCSI HBA.
//
//  A *software* SCSI Parallel Interface controller: it matches on
//  IOUserResources (no PCI/hardware provider) and presents targets/LUNs that
//  the iscsid daemon services over iSCSI. See docs/architecture.md for the
//  single-segment throughput caveat that gates this backend.
//
//  Signatures match SCSIControllerDriverKit (DriverKit 27 SDK): the report/
//  query methods use out-parameters and return kern_return_t.
//

#ifndef iSCSIDext_h
#define iSCSIDext_h

#include <DriverKit/IOService.iig>
#include <SCSIControllerDriverKit/IOUserSCSIParallelInterfaceController.iig>

class iSCSIDext: public IOUserSCSIParallelInterfaceController
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // Controller lifecycle.
    virtual kern_return_t UserInitializeController() override;
    virtual kern_return_t UserStartController() override;
    virtual kern_return_t UserInitializeTargetForID(SCSITargetIdentifier targetID) override;

    // Capability/identity reports (out-parameter style).
    virtual kern_return_t UserReportInitiatorIdentifier(uint64_t * id) override;
    virtual kern_return_t UserReportHighestSupportedDeviceID(uint64_t * id) override;
    virtual kern_return_t UserReportMaximumTaskCount(uint32_t * count) override;
    virtual kern_return_t UserReportHBAHighestLogicalUnitNumber(uint64_t * value) override;
    virtual kern_return_t UserDoesHBAPerformDeviceManagement(bool * result) override;
    virtual kern_return_t UserDoesHBAPerformAutoSense(bool * result) override;
    // Also pure-virtual in the base: omitting any of these makes the framework
    // fail Start() right after UserInitializeController().
    virtual kern_return_t UserDoesHBASupportMultiPathing(bool * result) override;
    virtual kern_return_t UserMapHBAData(uint32_t * uniqueTaskID) override;
    virtual kern_return_t UserDoesHBASupportSCSIParallelFeature(
        uint32_t theValue, bool * result) override;
    // The framework asks for the DMA spec while starting the controller; it
    // must agree with the constraints reported in UserInitializeController
    // (maxTransferSize >= segmentCount * segmentByteCount).
    virtual kern_return_t UserGetDMASpecification(
        uint64_t * maxTransferSize,
        uint32_t * alignment,
        uint8_t * numAddressBits,
        DMAOutputSegmentType * segmentType) override;

    // The I/O path. On an override the OSAction parameter must NOT repeat the
    // TYPE(ParallelTaskCompletion) annotation (the base already established
    // it; repeating it makes iig assert).
    virtual kern_return_t UserProcessParallelTask(
        SCSIUserParallelTask parallelRequest,
        uint32_t * response,
        OSAction * completion) override;

    // Bundled-task API. Both are pure-virtual in the base, so they MUST be
    // overridden or the framework fails Start(). We deliberately return
    // kIOReturnFailure from the map call, which is the documented way to opt
    // out of bundled mode and keep the simpler UserProcessParallelTask path.
    virtual kern_return_t UserMapBundledParallelTaskCommandAndResponseBuffers(
        IOBufferMemoryDescriptor * parallelCommandIOMemoryDescriptor,
        IOBufferMemoryDescriptor * parallelResponseIOMemoryDescriptor) override;
    // Never invoked while we opt out above; must still exist. The OSAction
    // parameter must NOT repeat the base's TYPE() annotation (iig asserts).
    virtual void UserProcessBundledParallelTasks(
        const uint16_t parallelRequestSlotIndices[kMaxBundledParallelTasks],
        uint16_t parallelRequestSlotIndicesCount,
        OSAction * completion) override;

    // Task management (theT=target, theL=lun, theQ=tagged task id).
    virtual kern_return_t UserAbortTaskRequest(
        uint64_t theT, uint64_t theL, uint64_t theQ, uint32_t * response) override;
    virtual kern_return_t UserAbortTaskSetRequest(
        uint64_t theT, uint64_t theL, uint32_t * response) override;
    virtual kern_return_t UserClearACARequest(
        uint64_t theT, uint64_t theL, uint32_t * response) override;
    virtual kern_return_t UserClearTaskSetRequest(
        uint64_t theT, uint64_t theL, uint32_t * response) override;
    virtual kern_return_t UserLogicalUnitResetRequest(
        uint64_t theT, uint64_t theL, uint32_t * response) override;
    virtual kern_return_t UserTargetResetRequest(
        uint64_t theT, uint32_t * response) override;

    // Called (on the dext queue) when the daemon posts a completion for an
    // outstanding task; looks up the parked completion and finishes it.
    virtual void CompleteTaskFromDaemon(
        uint64_t taskTag, uint32_t scsiStatus, uint32_t dataLength) LOCALONLY;

    // Publishes the virtual target. MUST NOT be called from inside
    // UserStartController: UserCreateTargetForID runs on the Auxiliary queue
    // and the framework calls UserInitializeTargetForID back into the dext
    // before it returns, so calling it while the dext queue is blocked in
    // UserStartController deadlocks (PM then reports a stuck driver callout).
    // It is dispatched asynchronously instead.
    virtual void PublishVirtualTarget() LOCALONLY;
};

#endif /* iSCSIDext_h */
