<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No com.apple.developer.system-extension.install: only the parked
         Backend B (ISCSI_BACKEND_B, ExtensionController) installs a system
         extension, and nothing that ships does. A Backend B build that needs
         it adds it back with the flag (docs/entitlements.md). -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
