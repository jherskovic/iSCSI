<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>iSCSI Initiator</string>
    <key>CFBundleIdentifier</key>
    <string>me.herko.iSCSIInitiator</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Sparkle. The feed lives in this repo and its enclosures point at
         GitHub Release assets. -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/jherskovic/iSCSI/main/appcast.xml</string>
    <!-- EdDSA public key. The private half lives in the login keychain of
         whoever cuts releases; scripts/release.sh refuses to build if the two
         do not exist. Replace with the output of Sparkle's generate_keys. -->
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_SPARKLE_PUBLIC_KEY</string>
    <!-- Checking in the background is fine. Installing without being asked is
         not: replacing the bundle swaps the FSKit extension out from under a
         mounted volume, which is data loss rather than an inconvenience. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>iSCSI Initiator</string>
</dict>
</plist>
