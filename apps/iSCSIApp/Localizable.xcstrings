            "state": "translated",
            "value": "“%1$@”正在使用中"
          }
        }
      }
    },
    "“%@” is in use and was not ejected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”正在使用中，无法推出"
          }
        }
      }
    },
    "“%@” is not an address the target can be reached at.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过“%1$@”访问存储目标。"
