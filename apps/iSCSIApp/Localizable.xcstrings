    "Searching…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在搜索…"
          }
        }
      }
    },
    "Secrets must be at least 12 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥至少需要 12 个字节（ASCII 字符至少 12 个）。"
          }
        }
      }
    },
    "Select a %@ target to remove it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个 %1$@ 目标以移除"
          }
        }
      }
    },
