            "value": "连接状态"
          }
        }
      }
    },
    "Setup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始设置"
          }
        }
      }
    },
    "Setup is not finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始设置尚未完成"
          }
