<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>iSCSIFSExtension</string>
    <key>CFBundleIdentifier</key>
    <string>me.herko.iSCSIInitiator.fsext</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- Every FS* key must live INSIDE EXAppExtensionAttributes. At the top
         level they are silently ignored. Shape copied from Apple's shipping
         URL-resource module, /System/Library/ExtensionKit/Extensions/
         com.apple.fskit.ftp.appex — which, like Backend A, is a filesystem with
         no block device behind it. See docs/backend-a-fskit-notes.md. -->
    <key>EXAppExtensionAttributes</key>
    <dict>
        <key>EXExtensionPointIdentifier</key>
        <string>com.apple.fskit.fsmodule</string>
        <key>FSShortName</key>
        <string>iSCSI</string>
        <!-- Backend A serves the LUN as a file; there is no block device. -->
        <key>FSSupportsBlockResources</key>
        <false/>
        <key>FSSupportsGenericURLResources</key>
        <true/>
        <key>FSSupportsPathURLs</key>
        <false/>
        <key>FSRequiresSecurityScopedPathURLResources</key>
        <false/>
        <key>FSSupportedSchemes</key>
        <array>
            <string>iscsi</string>
        </array>
        <!-- Declares that the module supports the mount/activate operation.
             Without it, mount(8) rejects the module with "Filesystem <name>
             does not support operation mount" — which is exactly why Apple's
             own exfat module cannot be mounted with `mount -F` while msdos and
             ftp can: exfat is the one that omits this key. "o:" matches ftp,
             the closest analogue (generic-URL resource, no block device). -->
        <key>FSActivateOptionSyntax</key>
        <dict>
            <key>shortOptions</key>
            <string>o:</string>
        </dict>
        <!-- Check/format syntax matched to ftp as well. fskit_agent validates
             modules at startup and silently prunes rejected ones from
             enabledModules.plist, so the declaration is kept identical to a
             known-good shipping module rather than minimal. -->
        <key>FSCheckOptionSyntax</key>
        <dict>
            <key>shortOptions</key>
            <string>nqy</string>
        </dict>
        <key>FSFormatOptionSyntax</key>
        <dict>
            <key>shortOptions</key>
            <string>v</string>
        </dict>
        <key>FSMediaTypes</key>
        <dict/>
        <key>FSPersonalities</key>
        <dict/>
    </dict>
</dict>
</plist>
