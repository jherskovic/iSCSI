<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- FSKit module capability. -->
    <key>com.apple.developer.fskit.fsmodule</key>
    <true/>
    <!-- Talk to the daemon over XPC for iSCSI I/O. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- A sandboxed extension cannot look up an arbitrary Mach service without
         an explicit exception; without this, NSXPCConnection to iscsid fails.
         The daemon does all the networking, so the extension itself never
         opens a socket. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>me.herko.iSCSIInitiator.daemon</string>
    </array>
</dict>
</plist>
