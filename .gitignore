.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.DS_Store
# Fuzzing leftovers. The first of these used to read `Fuzz/corpus-findings/`,
# which matched nothing: the directory is `Tests/Fuzz/corpus-findings/`, and a
# pattern containing a slash is anchored to the repo root. `fuzz-failures/` is
# where scripts/fuzz-campaign.sh writes, and was never ignored at all — so a
# failing campaign left untracked logs sitting in the working tree.
Tests/Fuzz/corpus-findings/
fuzz-failures/
apps/build/
apps/*.xcodeproj/project.xcworkspace/
apps/*.xcodeproj/xcuserdata/
*.p8
# iscsictl takes CHAP secrets from files rather than argv, so debugging a login
# leaves them in the working tree. Untracked is not the same as un-committable.
.secret
.mutual-secret
*.secret
build/
*.dmg
*.xcarchive

# py_compile leaves these behind
__pycache__/

# An instrumented binary run outside `swift test` (a `swift run iscsictl` after
# a coverage build, say) drops its raw profile in the working directory rather
# than under .build/.
*.profraw
